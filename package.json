{
  "name": "student-os",
  "private": true,
  "version": "0.1.0",
  "description": "Student OS —— 学生综合素质评价与成长管理系统",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:cloud": "vite --mode cloud",
    "build": "tsc --noEmit && vite build",
    "build:cloud": "npm run typecheck && vite build --mode cloud --outDir dist-cloud/public --emptyOutDir && vite build --config vite.server.config.ts",
    "build:artifact": "vite build --config vite.artifact.config.ts && node scripts/build-artifact.mjs",
    "start": "node --disable-warning=ExperimentalWarning dist-cloud/server.js",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server"
  },
  "dependencies": {
    "react": "19.1.10",
    "react-dom": "19.1.10"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=20.19"
  }
}
